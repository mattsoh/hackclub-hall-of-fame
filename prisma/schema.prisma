// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Message {
  messageId       String  @id
  channelId       String
  stars           Int     @default(0)
  postedMessageId String?
  announce        Boolean @default(true)
}

// Singleton row (id always 1) holding operational bookkeeping: sync cursor and
// counters for the daily overview report.
model AppState {
  id               Int      @id
  lastSyncedTs     String?
  statsWindowStart DateTime @default(now())
  starsIncreased   Int      @default(0)
  starsDecreased   Int      @default(0)
  newPosts         Int      @default(0)
}
