{
	"compilerOptions": {
		"module": "commonjs",
		"removeComments": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"allowSyntheticDefaultImports": true,
		"target": "es2020",
		"sourceMap": true,
		"outDir": "./dist",
		"baseUrl": "./",
		"skipLibCheck": true,
	},
  "include": [
    "./src/**/*.ts"
  ]
}